{
  "version": 1,
  "canonicalSystem": "shadcn/ui",
  "defaults": {
    "style": ["shadcn/ui", "flat", "compact"],
    "shellByProfile": {
      "list": "DataListPage",
      "create": "DataFormPage",
      "edit": "DataFormPage",
      "detail": "DataDetailPage"
    },
    "listShell": "DataListPage",
    "overlayConfirm": "AlertDialog",
    "toast": "Sonner"
  },
  "tagPrefixes": {
    "shell": "#shell:",
    "ui": "#ui:",
    "widget": "#widget:",
    "render": "#render:",
    "shape": "#shape:",
    "pattern": "#pattern:",
    "style": "#style:",
    "needsUi": "#needs-ui:",
    "legacy": "#legacy:",
    "behavior": "#behavior:",
    "token": "#token:"
  },
  "shells": {
    "DataListPage": {
      "canonical": "DataListPage",
      "tags": ["#shell: DataListPage"],
      "aliases": {
        "informal": [
          "DataListTable",
          "data list table",
          "common list",
          "list table",
          "search filter table",
          "bảng danh sách"
        ],
        "ant": ["Table + Form search"],
        "material": ["List"]
      },
      "portal": {
        "layer": "organism",
        "path": "components/organisms/DataListPage.vue",
        "status": "implemented",
        "layout": "dashboard"
      },
      "defaultFor": {
        "codegenProfile": "list"
      },
      "portalGen": {
        "templateStandard": "list/page.vue.hbs",
        "templateCustom": "list/page.custom.vue.hbs",
        "composableSuffix": "List",
        "layers": ["models", "service", "composable", "page", "mock"]
      },
      "commonSpecRef": "docs/features/yaml/common/list-page/common-list-page.bundle.yaml",
      "includes": {
        "organisms": ["DataListPage"],
        "molecules": ["MoSearchForm", "MoDataTable", "MoPaginationBar", "MoAppBar"],
        "slots": ["actions", "above-toolbar", "toolbar-end", "toolbar-start", "cell-{key}"]
      },
      "variants": {
        "standard": {
          "template": "list/page.vue.hbs",
          "when": "default list; no overrideCommonPattern"
        },
        "custom": {
          "template": "list/page.custom.vue.hbs",
          "when": "#shell: custom | ui.composition.pattern custom | overrideCommonPattern true"
        }
      }
    },
    "DataTablePage": {
      "canonical": "DataTablePage",
      "tags": ["#shell: DataTablePage"],
      "aliases": {
        "informal": ["simple table", "dashboard table", "table without search"]
      },
      "portal": {
        "layer": "organism",
        "path": "components/organisms/DataTablePage.vue",
        "status": "implemented"
      },
      "when": "Table đơn giản, không full search/filter shell"
    },
    "DataFormPage": {
      "canonical": "DataFormPage",
      "tags": ["#shell: DataFormPage"],
      "aliases": {
        "informal": ["form page", "create edit form", "settings form"]
      },
      "portal": {
        "layer": "organism",
        "path": "components/organisms/DataFormPage.vue",
        "status": "planned"
      },
      "defaultFor": {
        "codegenProfile": ["create", "edit"]
      },
      "portalGen": {
        "templateStandard": "create/page.vue.hbs",
        "composableSuffix": "Form",
        "layers": ["models", "service", "composable", "validation", "page", "mock"]
      }
    },
    "DataDetailPage": {
      "canonical": "DataDetailPage",
      "tags": ["#shell: DataDetailPage"],
      "aliases": {
        "ant": ["Descriptions"],
        "informal": ["detail page", "readonly view", "show page"]
      },
      "portal": {
        "layer": "organism",
        "path": "components/organisms/DataDetailPage.vue",
        "status": "planned"
      },
      "defaultFor": {
        "codegenProfile": "detail"
      }
    },
    "custom": {
      "canonical": "custom",
      "tags": ["#shell: custom"],
      "aliases": {
        "informal": ["override list", "custom layout", "layout đặc thù"]
      },
      "portalGen": {
        "listTemplate": "list/page.custom.vue.hbs",
        "requiresReason": true
      }
    }
  },
  "patterns": {
    "CRUD": {
      "canonical": "CRUD",
      "tags": ["#pattern: CRUD"],
      "aliases": {
        "informal": ["crud", "list create edit delete", "quản lý crud"]
      },
      "profiles": ["list", "create", "edit", "detail"]
    },
    "Settings": {
      "canonical": "Settings",
      "tags": ["#pattern: Settings"],
      "aliases": {
        "informal": ["settings", "config page", "cài đặt"]
      },
      "preferredShell": "DataFormPage",
      "preferredUi": ["Tabs", "Accordion", "Card"]
    },
    "Dashboard": {
      "canonical": "Dashboard",
      "tags": ["#pattern: Dashboard"],
      "aliases": {
        "ant": ["Statistic", "KPI"],
        "informal": ["dashboard", "analytics overview"]
      },
      "preferredUi": ["Card", "Chart"],
      "portalGen": "manual-blocks"
    },
    "Confirmation Flow": {
      "canonical": "Confirmation Flow",
      "tags": ["#pattern: Confirmation Flow"],
      "aliases": {
        "informal": ["confirm before delete", "xác nhận xóa", "confirm popup"]
      },
      "requiresUi": ["AlertDialog"]
    },
    "Empty State": {
      "canonical": "Empty State",
      "tags": ["#pattern: Empty State"],
      "preferredMolecule": "MoEmptyState"
    },
    "Loading State": {
      "canonical": "Loading State",
      "tags": ["#pattern: Loading State"],
      "preferredUi": ["Skeleton"]
    },
    "Filter Panel": {
      "canonical": "Filter Panel",
      "tags": ["#pattern: Filter Panel"],
      "aliases": {
        "informal": ["search filter", "filter bar"]
      },
      "includedInShell": ["DataListPage"]
    },
    "Sticky Header": {
      "canonical": "Sticky Header",
      "tags": ["#pattern: Sticky Header"],
      "preferredOrganism": "DataPageHeader"
    },
    "Master Detail": {
      "canonical": "Master Detail",
      "tags": ["#pattern: Master Detail"],
      "aliases": {
        "apple": ["Split View", "Inspector"]
      }
    },
    "Wizard": {
      "canonical": "Wizard",
      "tags": ["#pattern: Wizard"],
      "preferredUi": ["Stepper"]
    }
  },

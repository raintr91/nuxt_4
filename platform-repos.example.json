{
  "defaultGroup": "portal-stack",
  "groups": {
    "portal-stack": {
      "description": "Portal FE and API BE that usually change together",
      "primary": "portal",
      "projects": ["portal", "api"],
      "contract": {
        "frontend": "portal",
        "backend": "api",
        "sourceOfTruth": "docs-features-ir-spec"
      }
    },
    "erp-suite": {
      "description": "Example suite with multiple related apps — copy & rename",
      "primary": "erp-web",
      "projects": ["erp-web", "erp-api", "erp-worker", "erp-legacy-admin"],
      "contract": {
        "frontend": "erp-web",
        "backend": "erp-api",
        "sourceOfTruth": "backend-model-database"
      }
    }
  },
  "projects": {
    "portal": {
      "root": ".",
      "role": "frontend",
      "repo": "portal",
      "skill": "platform-base",
      "write": true
    },
    "api": {
      "root": "../api",
      "role": "backend",
      "repo": "api",
      "skill": "api-base",
      "write": true
    },
    "erp-web": {
      "root": "../erp-web",
      "role": "frontend",
      "repo": "portal",
      "skill": "platform-base",
      "write": true
    },
    "erp-api": {
      "root": "../erp-api",
      "role": "backend",
      "repo": "api",
      "skill": "api-base",
      "write": true
    },
    "erp-worker": {
      "root": "../erp-worker",
      "role": "worker",
      "write": true
    },
    "erp-legacy-admin": {
      "root": "../erp-legacy-admin",
      "role": "legacy",
      "write": false
    }
  }
}

{
  "name": "base_nuxt4",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:test": "bash scripts/dev-test.sh",
    "prepare:nuxt:e2e": "NUXT_BUILD_DIR=.nuxt-e2e nuxt prepare",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 nuxt prepare && STORYBOOK_DISABLE_TELEMETRY=1 node ./scripts/ensure-auto-stories.mjs && STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --loglevel error",
    "storybook:clean": "rm -rf node_modules/.cache/storybook",
    "storybook:clean:gen": "node ./scripts/clean-generated-stories.mjs",
    "storybook:fresh": "pnpm storybook:clean && pnpm storybook",
    "storybook:build": "STORYBOOK_DISABLE_TELEMETRY=1 nuxt prepare && STORYBOOK_DISABLE_TELEMETRY=1 node ./scripts/ensure-auto-stories.mjs && STORYBOOK_DISABLE_TELEMETRY=1 storybook build --loglevel error",
    "storybook:gen": "node ./scripts/generate-stories.mjs",
    "storybook:gen:force": "node ./scripts/generate-stories.mjs --force",
    "phase:gen": "node scripts/run-phase.mjs gen",
    "phase:unit": "node scripts/run-phase.mjs unit",
    "phase:e2e": "node scripts/run-phase.mjs e2e",
    "extracts:validate": "node scripts/extracts/validate.mjs",
    "portal:gen": "codegenkit gen --adapter=nuxt4 --project-root=. --",
    "portal:gen:dry": "codegenkit gen:dry --adapter=nuxt4 --project-root=. --",
    "portal:registry": "codegenkit registry --adapter=nuxt4 --project-root=.",
    "platform-common:registry": "node registries/validate-common.mjs validate",
    "portal:unit-gen": "codegenkit unit-gen --adapter=nuxt4 --project-root=. --",
    "portal:unit-gen:dry": "codegenkit unit-gen:dry --adapter=nuxt4 --project-root=. --",
    "portal:unit-registry": "codegenkit unit-registry --adapter=nuxt4 --project-root=.",
    "portal:e2e-registry": "testkit e2e-registry --project-root=.",
    "testcase:gen": "testkit testcase:gen --project-root=. --",
    "testcase:gen:dry": "testkit testcase:gen:dry --project-root=. --",
    "gen:id": "codegenkit gen --adapter=nuxt4 --project-root=. -- --id",
    "test:gen:id": "testkit testcase:gen --project-root=. -- --id",
    "portal:lifecycle": "node scripts/portal-lifecycle.mjs",
    "portal:remove": "node scripts/portal-remove.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "bash scripts/e2e_test.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:remote": "PLAYWRIGHT_SKIP_WEBSERVER=1 PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://portal.base.com} bash scripts/e2e_test.sh",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "ui:add": "shadcn-vue add",
    "ui:init": "shadcn-vue init"
  },
  "dependencies": {
    "@nuxt/eslint": "1.13.0",
    "@nuxtjs/i18n": "^10.2.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@radix-icons/vue": "^1.0.0",
    "@unovis/ts": "^1.6.4",
    "@unovis/vue": "^1.6.4",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.2.1",
    "chart.js": "^4.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "eslint": "^9.39.2",
    "lucide-vue-next": "^0.563.0",
    "nuxt": "^4.3.0",
    "pinia": "^3.0.4",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.9.10",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-a11y": "10.2.13",
    "@storybook/addon-docs": "10.2.13",
    "@storybook/addon-links": "10.2.13",
    "@storybook/vue3": "10.2.13",
    "@storybook/vue3-vite": "10.2.13",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "axe-core": "^4.12.1",
    "handlebars": "^4.7.9",
    "happy-dom": "^20.4.0",
    "dayjs": "^1.11.21",
    "mermaid": "^11.16.0",
    "postcss": "^8.5.6",
    "shadcn-nuxt": "^2.4.3",
    "shadcn-vue": "2.4.3",
    "storybook": "10.2.13",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^0.18.6",
    "vitest": "^4.0.18",
    "yaml": "^2.9.0"
  },
  "imports": {
    "#scripts/*": "./scripts/*",
    "#nuxt-eslint": "./.nuxt/eslint.config.mjs"
  },
  "storybook": {
    "generatedDir": "stories/auto",
    "manualStoriesGlob": "stories/*.stories.ts",
    "preserveManual": true
  }
}

{
  "name": "portal",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port ${PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "phase:gen": "node scripts/run-phase.mjs gen",
    "phase:unit": "node scripts/run-phase.mjs unit",
    "phase:e2e": "node scripts/run-phase.mjs e2e",
    "extracts:validate": "node scripts/extracts/validate.mjs",
    "contract:gen": "node contractgen/runners/generate.mjs",
    "contract:gen:dry": "node contractgen/runners/generate.mjs --dry-run",
    "contract:registry": "node contractgen/runners/validate-registry.mjs",
    "portal:gen": "node codegen/runners/generate.mjs",
    "portal:gen:dry": "node codegen/runners/generate.mjs --dry-run",
    "portal:gen:common": "node codegen/runners/generate.mjs --yaml-root ../base-docs/product/common/yaml",
    "portal:gen:dry:common": "node codegen/runners/generate.mjs --yaml-root ../base-docs/product/common/yaml --dry-run",
    "portal:registry": "node codegen/runners/validate-registry.mjs",
    "portal:unit-gen": "node unitgen/runners/generate.mjs",
    "portal:unit-gen:dry": "node unitgen/runners/generate.mjs --dry-run",
    "portal:unit-registry": "node unitgen/runners/validate-registry.mjs",
    "portal:e2e-registry": "node testgen/runners/validate-registry.mjs",
    "testcase:gen": "node testgen/runners/generate.mjs",
    "testcase:gen:dry": "node testgen/runners/generate.mjs --dry-run",
    "portal:lifecycle": "node scripts/portal-lifecycle.mjs",
    "portal:remove": "node scripts/portal-remove.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "dev:test": "bash scripts/dev-test.sh",
    "test:e2e": "bash scripts/e2e_test.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "ui:add": "pnpm exec shadcn add",
    "gen:id": "node codegen/runners/generate.mjs --id",
    "test:gen:id": "node testgen/runners/generate.mjs --id"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.0.0",
    "@portal/models": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.500.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "dayjs": "^1.11.21",
    "handlebars": "^4.7.9",
    "happy-dom": "^20.4.0",
    "mermaid": "^11.16.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "yaml": "^2.9.0"
  },
  "imports": {
    "#scripts/*": "./scripts/*"
  }
}

{
  "defaultGroup": "factory-ai-stack",
  "groups": {
    "factory-ai-stack": {
      "description": "Factory AI Platform — portal + fast + line + integration (4 repo)",
      "primary": "portal",
      "projects": ["portal", "fast-api-base", "line", "integration"],
      "contract": {
        "frontend": "portal",
        "backend": "fast-api-base",
        "sourceOfTruth": "docs-features-ir-spec"
      }
    },
    "v2-mairy-stack": {
      "description": "New SaaS Laravel API and three tenant portals for admin, chain, and store roles",
      "primary": "v2-mairy-admin",
      "projects": ["v2-mairy-admin", "v2-mairy-chain", "v2-mairy-store", "v2-mairy"],
      "contract": {
        "frontend": "v2-mairy-admin",
        "backend": "v2-mairy",
        "sourceOfTruth": "backend-model-database"
      }
    },
    "mairy-legacy-stack": {
      "description": "Legacy Mairy monolith, Nuxt store portal, and supporting systems used for code-to-spec analysis",
      "primary": "mairy-backend",
      "projects": ["mairy-backend", "mairy-frontend", "mairy-fullsco", "mairy-scenario", "mairy-crawl"],
      "contract": {
        "frontend": "mairy-frontend",
        "backend": "mairy-backend",
        "sourceOfTruth": "legacy-backend-model-database"
      }
    }
  },
  "projects": {
    "portal": {
      "root": ".",
      "role": "frontend-factory",
      "repo": "portal",
      "skill": "portal-base",
      "description": "Next.js 15 — Factory AI portal (src/ at repo root)",
      "write": true
    },
    "fast-api-base": {
      "root": "../fast-api-base",
      "role": "backend",
      "repo": "fast-api-base",
      "description": "FastAPI backend for Factory AI Platform — sole API for portal and line clients",
      "write": true
    },
    "line": {
      "root": "../line",
      "role": "line-client",
      "repo": "line",
      "description": ".NET shop-floor client — kiosk/check-in, calls fast-api-base",
      "write": true
    },
    "integration": {
      "root": "../integration",
      "role": "integration-gateway",
      "repo": "integration",
      "description": ".NET OT gateway — MES/PLC adapters, called by fast-api-base",
      "write": true
    },
    "api": {
      "root": "../api",
      "role": "backend",
      "description": "Laravel API (Mairy SaaS) — reference / optional stack",
      "write": true
    },
    "v2-mairy-admin": {
      "root": "../v2-mairy-admin",
      "role": "frontend-admin",
      "description": "New admin portal for SaaS operations",
      "write": true
    },
    "v2-mairy-store": {
      "root": "../v2-mairy-store",
      "role": "frontend-store",
      "description": "New store portal",
      "write": true
    },
    "mairy-backend": {
      "root": "../mairy-backend",
      "role": "legacy-backend",
      "description": "Legacy Laravel monolith — read-only for /legacy-spec",
      "write": false
    },
    "mairy-frontend": {
      "root": "../mairy-frontend",
      "role": "legacy-frontend-store",
      "description": "Legacy Nuxt 3 store portal — read-only",
      "write": false
    },
    "mairy-fullsco": {
      "root": "../mairy-fullsco",
      "role": "legacy-fullsco",
      "description": "Legacy Fullsco UI — read-only",
      "write": false
    },
    "mairy-scenario": {
      "root": "../mairy-scenario",
      "role": "legacy-scenario-service",
      "description": "Legacy scenario service — read-only",
      "write": false
    },
    "mairy-crawl": {
      "root": "../mairy-crawl",
      "role": "legacy-crawler",
      "description": "Legacy crawler — read-only",
      "write": false
    }
  }
}

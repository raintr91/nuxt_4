{
  "defaultGroup": "factory-ai-stack",
  "groups": {
    "factory-ai-stack": {
      "description": "Factory AI Platform — portal + fast + line + integration (4 repo)",
      "primary": "portal",
      "projects": ["portal", "fast-api-base", "line", "integration"],
      "contract": {
        "frontend": "portal",
        "backend": "fast-api-base",
        "sourceOfTruth": "docs-features-ir-spec"
      }
    },
    "portal-stack": {
      "description": "Example: single FE + API pair (copy & rename for other products)",
      "primary": "portal-fe",
      "projects": ["portal-fe", "api-be"],
      "contract": {
        "frontend": "portal-fe",
        "backend": "api-be",
        "sourceOfTruth": "backend-model-database"
      }
    }
  },
  "projects": {
    "portal": {
      "root": ".",
      "role": "frontend-factory",
      "repo": "portal",
      "skill": "portal-base",
      "description": "Next.js 15 — Factory AI portal (src/ at repo root)",
      "write": true
    },
    "fast-api-base": {
      "root": "../fast-api-base",
      "role": "backend",
      "repo": "fast-api-base",
      "skill": "fast-spec",
      "description": "FastAPI backend — sole API for portal + line",
      "write": true
    },
    "line": {
      "root": "../line",
      "role": "line-client",
      "repo": "line",
      "description": ".NET shop-floor client — calls fast-api-base",
      "write": true
    },
    "integration": {
      "root": "../integration",
      "role": "integration-gateway",
      "repo": "integration",
      "description": ".NET OT gateway — MES/PLC adapters",
      "write": true
    },
    "portal-fe": {
      "root": ".",
      "role": "frontend",
      "repo": "portal",
      "skill": "portal-base",
      "write": true
    },
    "api-be": {
      "root": "../api",
      "role": "backend",
      "repo": "api",
      "skill": "api-base",
      "write": true
    }
  }
}

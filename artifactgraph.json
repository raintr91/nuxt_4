{
  "version": 1,
  "stack": "nextjs",
  "mode": "brownfield",
  "commands": {
    "genDry": [
      "pnpm",
      "portal:gen:dry",
      "--id",
      "{spec}"
    ],
    "gen": [
      "pnpm",
      "portal:gen",
      "--id",
      "{spec}"
    ],
    "unitGenDry": [
      "pnpm",
      "portal:unit-gen:dry",
      "--spec",
      "{spec}"
    ],
    "contractGenDry": [
      "pnpm",
      "contract:gen:dry",
      "--spec",
      "{spec}"
    ],
    "registryValidate": [
      "pnpm",
      "portal:registry"
    ],
    "contractRegistry": [
      "pnpm",
      "contract:registry"
    ],
    "testcaseGenDry": [
      "pnpm",
      "testcase:gen:dry",
      "--id",
      "{spec}"
    ],
    "testcaseGen": [
      "pnpm",
      "testcase:gen",
      "--id",
      "{spec}"
    ],
    "docsRender": [
      "pnpm",
      "--dir",
      "@base-docs",
      "docs:render"
    ],
    "docsRenderCommon": [
      "pnpm",
      "--dir",
      "@base-docs",
      "docs:render:common"
    ],
    "specSplit": [
      "pnpm",
      "--dir",
      "@base-docs",
      "spec:split",
      "--",
      "{spec}"
    ],
    "specSplitAll": [
      "pnpm",
      "--dir",
      "@base-docs",
      "spec:split:all"
    ],
    "specSplitCheck": [
      "pnpm",
      "--dir",
      "@base-docs",
      "spec:split:check",
      "--",
      "{spec}"
    ]
  },
  "registries": [
    "registries/design.registry.json",
    "registries/unit-test.registry.json",
    "registries/e2e-test.registry.json",
    "registries/contract-field.registry.json"
  ],
  "gapSources": [
    "@base-docs/product/**/generated/HANDOFF.md",
    "@base-docs/product/**/generated/UNIT-HANDOFF.md",
    "@base-docs/product/**/generated/codegen.manifest.json",
    "**/generated/HANDOFF.md",
    "**/generated/UNIT-HANDOFF.md",
    "**/generated/codegen.manifest.json"
  ],
  "specRoots": [
    "@base-docs/product",
    "@base-tests/cases",
    "@base-tests/suites"
  ],
  "templates": {
    "root": "codegen/templates",
    "engine": "hbs"
  },
  "projectId": "nextjs",
  "dsl": {
    "lanes": {}
  },
  "hubs": {
    "docs": "base-docs",
    "tests": "base-tests"
  },
  "vocabularies": {
    "registryTags": "@base-docs/platform/toolchain/lexicon/registry-tags.en.txt",
    "testTaxonomy": "@base-tests/catalog/lexicon/testcase-taxonomy.en.txt"
  }
}
